  {
   "id": "d1",
   "who": "debby",
   "text": "Permisi! Aku mau ketemu Pak Presiden!"
  },
  {
   "id": "g1",
   "who": "bodyguard",
   "text": "Mundur! Identitas dulu!"
  },
  {
   "id": "n1",
   "who": "narrator",
   "text": "Malam ini, dua komentar jadi nyata: sekretaris presiden, dan study tour!"
  },
  {
   "id": "e1",
   "who": "ega",
   "text": "Debby! Mulai hari ini, kamu Sekretaris Presiden!"
  },
  {
   "id": "d2",
   "who": "debby",
   "text": "Akhirnya aku masuk juga!"
  },
  {
   "id": "d3",
   "who": "debby",
   "text": "Pak Presiden, jadwal Bapak hari ini: PR dari Bu Guru Gina."
  },
  {
   "id": "e2",
   "who": "ega",
   "text": "...Cuma itu?"
  },
  {
   "id": "d4",
   "who": "debby",
   "text": "Itu yang paling penting, Pak."
  },
  {
   "id": "g2",
   "who": "bodyguard",
   "text": "Sekretaris juga harus... identitas dulu!"
  },
  {
   "id": "d5",
