 "lines": [
  {
   "id": "k1",
   "who": "keeper",
   "text": "Akhirnya... aku sampai juga di Pulau Aru."
  },
  {
   "id": "n1",
   "who": "narrator",
   "text": "Di pulau ini, setiap follower jadi warga. Dan komentar kalian... jadi cerita."
  },
  {
   "id": "x1",
   "who": "feros",
   "text": "Kapal pertama berangkat! Nelayan pertama, jadi kapten!"
  },
  {
   "id": "n2",
   "who": "narrator",
   "text": "Kemarin Aru bertanya: kapal pertama ini... akan pulang bawa siapa?"
  },
  {
   "id": "r1",
   "who": "rayhan",
   "text": "Hati-hati, Feros! Jangan pulang bawa sandal kayak aku!"
  },
  {
   "id": "d1",
   "who": "daby",
   "text": "Aku yang pertama sambut kapalnya!"
  },
  {
   "id": "p1",
   "who": "princes",
   "text": "Princess selalu duluan, ya!"
  },
  {
   "id": "n3",
   "who": "narrator",
   "text": "Sore harinya, kapal pulang. Tapi ada satu penumpang."
  },
  {
   "id": "x2",
   "who": "feros",
   "text": "Aku nemu dia di Pulau Seberang. Bawa lentera."
  },
  {
   "id": "k2",
   "who": "keeper",
   "text": "Aku... Penjaga Mercusuar."
  },
  {
   "id": "a1",
   "who": "aru",
   "text": "Yang kirim surat itu?!"
  },
  {
   "id": "k3",
   "who": "keeper",
   "text": "Pemimpin pulau harus dipilih warga. Bukan ditunjuk."
  },
  {
   "id": "n4",
   "who": "narrator",
   "text": "Ia menginap di Kamar Tiga Hotel Pulau. Membawa satu kabar."
  },
  {
   "id": "k4",
   "who": "keeper",
   "text": "Masa jabatan presiden... berakhir empat belas November."
  },
  {
   "id": "a2",
   "who": "aru",
   "text": "Berarti... pemilu lagi?!"
  },
  {
   "id": "n5",
   "who": "narrator",
   "text": "Follow, namamu jadi warga. Komentar, ceritanya kamu yang atur."
  },
  {
   "id": "a3",
   "who": "aru",
   "text": "Siapa yang pantas jadi presiden berikutnya? Tulis di komentar!"
  }
