    {
      "id": "x1",
      "who": "zidan",
      "text": "Komentar: bikin masjid. Pagi ini... berdiri!"
    },
    {
      "id": "n1",
      "who": "narrator",
      "text": "Di pulau ini, komentar kalian jadi kenyataan."
    },
    {
      "id": "n2",
      "who": "narrator",
      "text": "Dua komentar terpilih hari ini!"
    },
    {
      "id": "n3",
      "who": "narrator",
      "text": "Masjid besar jauh di utara. Jadi, buat warga sini: Mushola Warga!"
    },
    {
      "id": "z1",
      "who": "zidan",
      "text": "Sandalnya dilepas dulu ya, kak. Raknya baru!"
    },
    {
      "id": "d1",
      "who": "dayang",
      "text": "Halo! Aku Dayang... boleh tinggal di sini?"
    },
    {
      "id": "n5",
      "who": "narrator",
      "text": "Boleh! Dan semalam, Ish traktir sepuluh kali."
    },
    {
      "id": "n6",
      "who": "narrator",
      "text": "Pesannya: semangat berkarya, dan bantu memudahkan pekerjaan orang lain."
    },
    {
      "id": "a1",
      "who": "aru",
      "text": "Pesan sebaik itu harus jadi bangunan. Pos Gotong Royong!"
    },
    {
      "id": "d2",
      "who": "dayang",
      "text": "Aku mau jadi relawan pertamanya!"
    },
    {
      "id": "n7",
      "who": "narrator",
      "text": "Tugas pertama: bantu Revan dorong gerobak kedua."
    },
    {
      "id": "r1",
      "who": "revan",
      "text": "Kali ini pasti emas... SANDAL LAGI?!"
    },
    {
      "id": "n9",
      "who": "narrator",
      "text": "Follow, namamu jadi warga. Komentar, ceritanya kamu yang atur."
    }
