 "lines": [
  {
   "id": "x1",
   "who": "aru",
   "text": "Pencuri sandalnya... BURUNG?!"
  },
  {
   "id": "n1",
   "who": "narrator",
   "text": "Di pulau ini, follow jadi warga, dan komentar kalian yang atur ceritanya."
  },
  {
   "id": "n2",
   "who": "narrator",
   "text": "Kemarin, tujuh sandal warga hilang."
  },
  {
   "id": "a1",
   "who": "aru",
   "text": "Termasuk sandalku. Satu-satunya!"
  },
  {
   "id": "n3",
   "who": "narrator",
   "text": "Lalu dua warga menulis di komentar: kami mau jadi polisi!"
  },
  {
   "id": "r1",
   "who": "ranu",
   "text": "Permintaan diterima. Selamat datang, Detektif Pantai!"
  },
  {
   "id": "d1",
   "who": "alfaiz",
   "text": "Jejak tiga jari. Pelakunya pasti balik lagi."
  },
  {
   "id": "a2",
   "who": "aru",
   "text": "Kalau gitu, kita pasang kamera jaga malam!"
  },
  {
   "id": "n4",
   "who": "narrator",
   "text": "Detektif ngala punya ide: pasang umpan."
  },
  {
   "id": "y1",
   "who": "inyuu",
   "text": "Pakai sandalku aja! GG, warga!"
  },
  {
   "id": "l1",
   "who": "d4l",
   "text": "Boleh nggak... aku ikut jaga?"
  },
  {
   "id": "n5",
   "who": "narrator",
   "text": "Malam tiba. Semua menunggu."
  },
  {
   "id": "y2",
   "who": "inyuu",
   "text": "Ngantuk... aku respawn dulu..."
  },
  {
   "id": "n6",
   "who": "narrator",
   "text": "Jam dua pagi, kamera merekam sesuatu!"
  },
  {
   "id": "a3",
   "who": "aru",
   "text": "Itu... BURUNG CAMAR?!"
  },
  {
   "id": "n7",
   "who": "narrator",
   "text": "Camar itu terbang membawa sandal, ke puncak mercusuar."
  },
  {
   "id": "y3",
   "who": "inyuu",
   "text": "Sandal umpanku... ikut hilang."
  },
  {
   "id": "a4",
   "who": "aru",
   "text": "Tapi... buat apa camar ngumpulin sandal?"
  },
  {
   "id": "n8",
   "who": "narrator",
   "text": "Tulis tebakanmu di komentar! Follow, namamu jadi warga."
  }
