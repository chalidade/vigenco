{
  "name": "vigenco",
  "version": "0.1.0",
  "private": true,
  "description": "Spec-in, MP4-out motion video generator. Each video type is a pure seek(t) HTML film rendered with Playwright + ffmpeg.",
  "type": "module",
  "bin": { "vigenco": "bin/vigenco.mjs" },
  "scripts": {
    "render": "node bin/vigenco.mjs render",
    "snap": "node bin/vigenco.mjs snap",
    "draft": "node bin/vigenco.mjs render --quality draft"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "playwright": "^1.63.0"
  }
}
